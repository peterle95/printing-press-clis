# Trello credentials (required; never put these in config.toml)
TRELLO_API_KEY=
TRELLO_TOKEN=

# Planner IDs (may instead be set in config.toml)
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# Google OAuth desktop client credentials (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth2/callback

# Optional; defaults to primary and may instead be set in config.toml
GOOGLE_CALENDAR_ID=primary
